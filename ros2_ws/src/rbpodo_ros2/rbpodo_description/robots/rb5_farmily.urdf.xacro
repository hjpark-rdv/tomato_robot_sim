<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rb5_farmily">

  <!-- Keep the Rainbow Robotics RB5 model as the unmodified base robot. -->
  <xacro:include filename="$(find rbpodo_description)/robots/rb5_850e.urdf.xacro" />
  <xacro:include filename="$(find rbpodo_description)/robots/realsense_d435.urdf.xacro" />

  <xacro:arg name="d435_mount_x" default="-0.11" />
  <xacro:arg name="d435_mount_y" default="-0.10" />
  <xacro:arg name="d435_mount_z" default="0.0" />
  <xacro:arg name="d435_mount_roll" default="-1.57" />
  <xacro:arg name="d435_mount_pitch" default="0.0" />
  <xacro:arg name="d435_mount_yaw" default="3.141592" />

  <!-- Farmily lift pose relative to the RB5 base frame (link0). -->
  <xacro:arg name="lift_mount_x" default="0.0" />
  <xacro:arg name="lift_mount_y" default="0.6" />
  <xacro:arg name="lift_mount_z" default="-0.35" />
  <xacro:arg name="lift_mount_roll" default="1.57" />
  <xacro:arg name="lift_mount_pitch" default="0.0" />
  <xacro:arg name="lift_mount_yaw" default="-1.57" />

  <!-- Farmily-specific links and joints belong below this line. -->
  <link name="$(arg prefix)farmily_lift">
    <visual>
      <geometry>
        <!-- Assy_Lift.STL is authored in millimetres. -->
        <mesh
          filename="package://rbpodo_description/meshes/farmily_lift/assy_lift.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="farmily_lift_gray">
        <color rgba="0.32 0.34 0.38 1.0" />
      </material>
    </visual>
  </link>

  <joint name="$(arg prefix)farmily_lift_joint" type="fixed">
    <origin
      xyz="$(arg lift_mount_x) $(arg lift_mount_y) $(arg lift_mount_z)"
      rpy="$(arg lift_mount_roll) $(arg lift_mount_pitch) $(arg lift_mount_yaw)" />
    <parent link="$(arg prefix)link0" />
    <child link="$(arg prefix)farmily_lift" />
  </joint>

  <link name="$(arg prefix)tomato_gripper">
    <visual>
      <geometry>
        <!-- The CAD mesh is authored in millimetres. -->
        <mesh
          filename="package://rbpodo_description/meshes/tomato_gripper/tomato_gripper.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
      <material name="tomato_gripper_gray">
        <color rgba="0.25 0.25 0.28 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh
          filename="package://rbpodo_description/meshes/tomato_gripper/tomato_gripper.stl"
          scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <joint name="$(arg prefix)tomato_gripper_joint" type="fixed">
    <origin xyz="0 0.01 0" rpy="3.14 0 0" />
    <parent link="$(arg prefix)tcp" />
    <child link="$(arg prefix)tomato_gripper" />
  </joint>

  <!--
    Planning TCP at the distal center of the tomato gripper. The STL is in
    millimetres and extends to x=-211.6 mm; y=10.75 mm is the center of the
    rounded tip at that section. Keep this fixed joint separate so the TCP can
    be calibrated without moving the visual/collision mesh.
  -->
  <link name="$(arg prefix)tomato_gripper_tip" />

  <joint name="$(arg prefix)tomato_gripper_tip_joint" type="fixed">
    <origin xyz="-0.2116 0.01075 0" rpy="1.57 3.14 0" />
    <parent link="$(arg prefix)tomato_gripper" />
    <child link="$(arg prefix)tomato_gripper_tip" />
  </joint>

  <!--
    D435 mounted above the gripper with its optical axis facing the gripper
    tip. These six mount arguments are calibration values and can be adjusted
    without editing the reusable camera model.
  -->
  <xacro:realsense_d435
    parent="$(arg prefix)tomato_gripper"
    name="$(arg prefix)d435"
    use_mesh="true">
    <origin
      xyz="$(arg d435_mount_x) $(arg d435_mount_y) $(arg d435_mount_z)"
      rpy="$(arg d435_mount_roll) $(arg d435_mount_pitch) $(arg d435_mount_yaw)" />
  </xacro:realsense_d435>

</robot>
